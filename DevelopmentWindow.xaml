<Window x:Class="HelloAutofill.DevelopmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Development options" Icon="res/win_hello.ico" Width="570" Height="400" MinWidth="500" MinHeight="330" WindowStartupLocation="CenterOwner" Background="#111217" Foreground="#F2F2F4" FontFamily="Segoe UI" ShowInTaskbar="False">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#F2F2F4" Text="Development options"/><TextBlock Margin="0,5,0,14" Foreground="#A8A8B2" TextWrapping="Wrap" Text="Placeholders only. Enable an option and assign Ctrl + Alt + Shift + a letter or number."/></StackPanel>
  <Border Grid.Row="1" Background="#1B1C23" BorderBrush="#41424D" BorderThickness="1" CornerRadius="6" Padding="8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
    <TextBlock Foreground="#A8A8B2" FontSize="11" FontWeight="SemiBold" Text="ENABLED"/><TextBlock Grid.Column="1" Foreground="#A8A8B2" FontSize="11" FontWeight="SemiBold" Text="OPTION"/><TextBlock Grid.Column="2" Foreground="#A8A8B2" FontSize="11" FontWeight="SemiBold" Text="KEY"/>
    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" x:Name="OptionsList" Margin="0,8,0,0">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
       <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
       <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F2F2F4" VerticalAlignment="Center"/>
       <TextBox Grid.Column="2" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Padding="8,5" Background="#25262E" Foreground="White" CaretBrush="White" BorderBrush="#41424D"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>
  <TextBlock Grid.Row="2" x:Name="Message" Foreground="#F18B98" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Save" Padding="14,7" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>

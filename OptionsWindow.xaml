<Window x:Class="HelloAutofill.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Options" Icon="res/win_hello.ico" Width="420" Height="235" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#111217" Foreground="#F2F2F4" FontFamily="Segoe UI" ShowInTaskbar="False">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Options" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose how Hello Autofill starts." Foreground="#A8A8B2" Margin="0,4,0,0"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,24,0,0"><CheckBox x:Name="StartWithWindows" Content="Start when I sign in to Windows" Foreground="#F2F2F4" Checked="StartupChanged" Unchecked="StartupChanged"/><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#F18B98" Margin="0,10,0,0"/></StackPanel>
  <Button Grid.Row="2" HorizontalAlignment="Right" Content="Done" Padding="18,7" Foreground="White" Background="#D23C4E" BorderThickness="0" Click="Done_Click"/>
 </Grid>
</Window>

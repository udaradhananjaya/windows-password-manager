<Window x:Class="HelloAutofill.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="About Hello Autofill" Icon="res/win_hello.ico" Width="470" Height="460" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#111217" Foreground="#F2F2F4" FontFamily="Segoe UI" ShowInTaskbar="False">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Hello Autofill by UD" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock x:Name="VersionText" Foreground="#A8A8B2" Margin="0,5,0,14"/>
   <TextBlock TextWrapping="Wrap" Text="A desktop utility created by UD to fill saved logins into matching Windows applications after Windows Hello verification."/>
   <TextBlock Text="Security disclaimer" FontSize="16" FontWeight="SemiBold" Foreground="#F18B98" Margin="0,20,0,8"/>
   <TextBlock TextWrapping="Wrap" Foreground="#D8D8DE" Text="Passwords are encrypted at rest by Windows Credential Manager under your Windows account. Windows Hello gates filling in this app; it does not cryptographically lock the stored passwords. Other software running under your account may be able to read them, and malware can observe typed input. Window title and executable checks can be spoofed. Incorrect tab order may expose a password. This prototype has not had an independent security review."/>
   <TextBlock Margin="0,16,0,0" Foreground="#A8A8B2" TextWrapping="Wrap" Text="The app checks GitHub for updates at startup and every 12 hours while running. Download and install updates yourself from the release page."/>
   <TextBlock x:Name="UpdateStatus" Margin="0,8,0,0" Foreground="#F18B98" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CheckButton" Content="Check now" Padding="12,7" Margin="0,0,8,0" Click="CheckUpdates_Click"/><Button Content="Open releases" Padding="12,7" Margin="0,0,8,0" Click="OpenReleases_Click"/><Button Content="Close" Padding="14,7" Click="Close_Click"/></StackPanel>
 </Grid>
</Window>
